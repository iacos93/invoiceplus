{
    "name": "iacos93/invoiceplus",
    "description": "Gestione di fatture, preventivi, clienti e pagamenti: porting di InvoicePlane su CodeIgniter 4",
    "keywords": [
        "fatturazione",
        "fatture",
        "preventivi",
        "invoiceplane",
        "codeigniter4"
    ],
    "homepage": "https://github.com/iacos93/invoiceplus",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Fabio Iacovino"
        }
    ],
    "support": {
        "issues": "https://github.com/iacos93/invoiceplus/issues",
        "source": "https://github.com/iacos93/invoiceplus"
    },
    "require": {
        "php": "^8.2",
        "chillerlan/php-qrcode": "^6.0",
        "codeigniter4/framework": "^4.7",
        "dompdf/dompdf": "^3.1",
        "lbuchs/webauthn": "^2.2",
        "predis/predis": "^3.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve --port 8080"
    }
}
