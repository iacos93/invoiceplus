#--------------------------------------------------------------------
# .env di PRODUZIONE — modello
#
# Copiare sul server come `.env` (non `env`) e sostituire ogni <...>.
# Nessun valore di sviluppo va riusato: la chiave di cifratura, le
# password e la mcp.key di sviluppo sono finite su disco in chiaro e
# vanno considerate note.
#--------------------------------------------------------------------

# In production il debugbar e le pagine d'errore dettagliate sono spenti:
# un'eccezione non deve mai mostrare query o percorsi a un cliente.
CI_ENVIRONMENT = production

# URL pubblico con https e slash finale: i link dei documenti guest e il
# feed .ics vengono costruiti da qui.
app.baseURL = 'https://<dominio>/'

# Redirect forzato a https e cookie Secure. Lasciato a false su dev
# perché il server PHP integrato non parla TLS.
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (Postgres)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = invoiceplane
database.default.username = <utente_dedicato>
database.default.password = <password_lunga_generata>
database.default.DBDriver = Postgre
database.default.port = 5432

# pg_dump della STESSA versione maggiore del server (o piu' recente):
# un pg_dump 16 rifiuta un server 17 e il backup notturno fallisce.
# Verificare con: <percorso>/pg_dump --version  e  SELECT version();
backup.pgDumpPath = /usr/lib/postgresql/17/bin/pg_dump

#--------------------------------------------------------------------
# CIFRATURA
#
# Generare con: php spark key:generate --show
# ATTENZIONE: Cryptor cifra token e segreti nel database con questa
# chiave. Se si importa il database di sviluppo, o si tiene la chiave
# di sviluppo o si ricifrano i campi: con una chiave nuova i token
# esistenti diventano illeggibili.
#--------------------------------------------------------------------
encryption.key = '<base64:...>'

#--------------------------------------------------------------------
# REDIS — con password: in produzione la porta 6379 non deve essere
# raggiungibile senza autenticazione (requirepass in redis.conf).
#--------------------------------------------------------------------
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
cache.redis.password = <password_redis>
cache.redis.database = 0

session.savePath = 'tcp://127.0.0.1:6379?database=1&auth=<password_redis>'

redis.queue.host = 127.0.0.1
redis.queue.port = 6379
redis.queue.password = <password_redis>
redis.queue.database = 2

#--------------------------------------------------------------------
# MCP — solo se l'endpoint /mcp viene usato. Generare con:
# php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
#--------------------------------------------------------------------
mcp.key = '<chiave_casuale>'
