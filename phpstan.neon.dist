includes:
    - phpstan-baseline.neon

parameters:
    # Livello 5 (era 3). Misurato il 2026-11-12: a livello 4 erano 30 rilievi,
    # a 5 erano 36, e riguardavano per lo piu' confronti che l'analizzatore
    # giudica sempre veri o falsi (costanti di ambiente nei file Config,
    # array_values() su liste, ??). Li ho letti uno per uno: nessun difetto
    # reale, sono registrati in phpstan-baseline.neon. Il codice nuovo viene
    # quindi controllato a livello 5 senza dover riscrivere quello vecchio.
    # I livelli oltre il 5 chiedono i generics dei model di CodeIgniter, che
    # qui non ci sono: salirci darebbe solo rumore.
    level: 5
    paths:
        - app
    excludePaths:
        # I template mescolano HTML e PHP e usano variabili estratte da
        # view(); senza tipizzarle l'analisi non ha appigli.
        - app/Views
        # Le migrazioni girano una volta sola e sono escluse dal classmap
        # (vedi composer.json): le verifica la CI ricreando lo schema.
        - app/Database/Migrations
        # File di configurazione copiato dal template di CodeIgniter: cita
        # classi di Kint, che e' una dipendenza di sviluppo facoltativa e non
        # e' installata qui.
        - app/Config/Kint.php
    scanDirectories:
        - vendor/codeigniter4/framework/system/Helpers
    bootstrapFiles:
        - phpstan-bootstrap.php
        - vendor/codeigniter4/framework/system/Common.php
        - app/Common.php
